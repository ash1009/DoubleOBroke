<?xml version="1.0" encoding="utf-8"?>
<!-- Google backup and phone-to-phone transfer on Android 12 and newer. Same rules for both:
     everything except keys the owner pasted in and phone-only things such as the backup folder. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="secrets.xml" />
        <exclude domain="sharedpref" path="device.xml" />
        <exclude domain="database" path="androidx.work.workdb" />
        <exclude domain="database" path="androidx.work.workdb-shm" />
        <exclude domain="database" path="androidx.work.workdb-wal" />
        <!-- Where you went stays on this phone. -->
        <exclude domain="database" path="travel.db" />
        <exclude domain="database" path="travel.db-shm" />
        <exclude domain="database" path="travel.db-wal" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="secrets.xml" />
        <exclude domain="sharedpref" path="device.xml" />
        <exclude domain="database" path="androidx.work.workdb" />
        <exclude domain="database" path="androidx.work.workdb-shm" />
        <exclude domain="database" path="androidx.work.workdb-wal" />
        <!-- Where you went stays on this phone. -->
        <exclude domain="database" path="travel.db" />
        <exclude domain="database" path="travel.db-shm" />
        <exclude domain="database" path="travel.db-wal" />
    </device-transfer>
</data-extraction-rules>
